{
	"workspaces": {
// project = What files belong to my project?
// entry   = Where should Knip start tracing what's actually used?
		"packages/*": {
			"entry": ["src/{index,main}.ts"],
			"project": ["src/**/*.{ts,tsx,svelte}"]
		}
	},
	"ignoreDependencies": [
		"syncpack",
		"@vitest/coverage-v8",
		"@testing-library/svelte",
		"@tsconfig/svelte"
	]
}
